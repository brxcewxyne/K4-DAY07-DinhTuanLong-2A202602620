# Embedding provider selection for manual experiments
# EMBEDDING_PROVIDER=mock
# EMBEDDING_PROVIDER=local
# EMBEDDING_PROVIDER=openai
# EMBEDDING_PROVIDER=gemini

# Optional: set cache directories for the local multilingual embedder
# HF_HOME=./.hf-cache
# SENTENCE_TRANSFORMERS_HOME=./.sentence-transformers

# Optional: OpenAI embedding configuration
# OPENAI_API_KEY=your-key-here
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Gemini API key.
# Required for Gemini-backed answer generation (agent_eval.py) and,
# separately, for the optional Gemini embedding backend.
GEMINI_API_KEY=your-key-here

# Gemini model used by agent_eval.py for answer generation.
GEMINI_MODEL=gemini-3.6-flash

# Optional: Gemini embedding configuration (free tier at aistudio.google.com)
# NOT used by the current Agent evaluation: retrieval uses LocalEmbedder
# (sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2).
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional: for ChromaDB persistence (bonus task)
# CHROMA_PERSIST_DIR=./chroma_data
